# Copy to .env and fill with your Supabase project values.
# These are exposed to the client bundle, so only ever use the publishable key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional: the deployed web domain used to build Live Board QR links.
# Without it, links fall back to localhost and cannot be opened from another
# device. Example: https://pickleboard.example.com
# EXPO_PUBLIC_APP_URL=https://pickleboard.example.com
