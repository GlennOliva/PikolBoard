# PickleBoard environment configuration
#
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# Only NEXT_PUBLIC_* variables reach the browser. The app never uses the
# service-role key anywhere (see docs/DATABASE.md).

# --- Supabase (required) -------------------------------------------------
# From Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public site origin. QR codes MUST use an address a phone can reach.
# Local browser only (shows a cross-device warning):
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local phone test example (replace with your computer's LAN address):
# NEXT_PUBLIC_APP_URL=http://10.9.21.83:3000
# Production example:
# NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# --- Local-only (server side, never exposed) ---------------------------
# Only needed by scripts/migrations, never by the browser bundle.
# DATABASE_URL=postgresql://postgres.your-ref:YOUR_DB_PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- End-to-end test organizer account (optional) ----------------------
# Create this user in Supabase Dashboard > Authentication > Users, or via
# `npm run e2e:setup-account`. Never commit real passwords.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
